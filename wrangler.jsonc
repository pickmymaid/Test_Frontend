{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pickmymaid",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Used by OpenNext for ISR/`fetch` cache (ISR revalidation, getBlogs/findMaids/getMaid `next.revalidate`).
  // Create it once with: npx wrangler kv namespace create NEXT_INC_CACHE_KV
  // then replace `id` below with the id it prints.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  // Required so ISR-tagged revalidation (revalidatePath in /api/revalidate) can
  // re-invoke this same Worker to regenerate pages on demand.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "pickmymaid"
    }
  ],
  "observability": {
    "enabled": true
  }
}
